{
  "manifest_version": 3,
  "name": "VBTV video controls",
  "short_name": "VBTV Controls",
  "version": "1.0.0",
  "description": "Keyboard shortcuts for VBTV volleyball video player",
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://tv.volleyballworld.com/player*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://tv.volleyballworld.com/player*"
  ],
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  }
}
